@article{Blonder2021advanced,
   author = {Blonder, Y. and Mazor, E. and Jew, K.},
   title = {Advanced Capnography Sampling Lines May Improve Patient Comfort and Compliance},
   journal = {Med Devices (Auckl)},
   volume = {14},
   pages = {37-42},
   note = {1179-1470
Blonder, Yedidia
Orcid: 0000-0001-9855-5650
